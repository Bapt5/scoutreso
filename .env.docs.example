# Variables lues au build du site de documentation (`pnpm docs:dev`, `pnpm docs:build`).
# Copier ce fichier en .env.docs : ses valeurs l'emportent sur celles de .env.
# En ligne : les définir dans l'environnement de build du site de documentation.

# URL de l'application de production. Sans elle, les boutons « Je suis
# responsable de groupe » et « Je suis membre du groupe » sont masqués.
# NEXT_PUBLIC_URL_APP_PROD=https://app.scoutreso.me

# URL de la démo. Sans elle, le bouton « Essayer sans compte » est masqué.
# NEXT_PUBLIC_URL_APP_DEMO=https://demo.scoutreso.me

# Mesure d'audience Umami (déjà lue par le site), activée si les deux sont définies
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Empreinte SHA-256 du certificat de scellement, affichée sur « Vérifier une note signée »
# NDF_SCELLEMENT_EMPREINTE_SHA256=
