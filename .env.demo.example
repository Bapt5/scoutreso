# Variables du projet de démonstration (voir docs/technical/demo.md).
# Local : copier ce fichier en .env.demo puis `docker compose -f compose.demo.yaml up -d`,
# `pnpm demo:migrate` et `pnpm dev:demo`. Les valeurs de .env.demo l'emportent sur .env et .env.local.
# En ligne : les définir dans le second projet Vercel (base PostgreSQL dédiée).

# Active le mode démo (lue au build)
NEXT_PUBLIC_DEMO_MODE=true

# Base PostgreSQL dédiée à la démo, jamais celle de la production
DATABASE_URL=postgresql://scoutreso_demo:scoutreso_demo@localhost:5433/scoutreso_demo

# Secrets propres à la démo
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-demo
AUDIT_LOG_SECRET=remplacer-par-un-autre-secret-aleatoire-de-demo

# URL publique de la démo
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Certificat auto-signé de démo : `pnpm ndf:certificat "Scoutreso Demo"`
NDF_SCELLEMENT_P12_BASE64=
NDF_SCELLEMENT_P12_MOT_DE_PASSE=

# Valeurs factices : aucun transport SMTP n'est jamais créé en démo, mais
# send-expense, send-recette et /api/health exigent leur présence.
SMTP_HOST=demo
SMTP_USER=demo
SMTP_PASSWORD=demo

# Route de purge optionnelle (Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=

# Bouton « Créer mon vrai groupe » du bandeau (URL de la production)
# NEXT_PUBLIC_URL_APP_PROD=https://app.scoutreso.me

# Mesure d'audience Umami : identifiant de site distinct de la production
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
